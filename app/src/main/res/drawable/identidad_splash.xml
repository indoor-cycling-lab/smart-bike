<?xml version="1.0" encoding="utf-8"?>
<!-- Splash animada: la rueda trasera gira 2 vueltas acelerando y termina en la posición del icono. Generado por scripts/design-system/generar.py a partir de design-system/identidad. No editar a mano. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/identidad_splash_vector">
    <target android:name="rueda">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="720"
                android:duration="900"
                android:interpolator="@android:interpolator/accelerate_quad" />
        </aapt:attr>
    </target>
</animated-vector>
