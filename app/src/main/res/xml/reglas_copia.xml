<?xml version="1.0" encoding="utf-8"?>
<!--
    Copia de seguridad de Android 12 en adelante (change preparar-release, decisión 5): solo la configuración, lo mismo
    que «Exportar configuración». Con un include, todo lo demás queda fuera: estado.json (dispositivos, identidades,
    últimas marchas y nombre Bluetooth original) y las sesiones grabadas. La ruta es la de Almacen.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/configuracion.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/configuracion.json" />
    </device-transfer>
</data-extraction-rules>
